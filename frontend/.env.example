# Backend API base URL (the FastAPI service). Leave empty to use the Vite
# dev proxy (http://localhost:8000).
VITE_API_URL=http://localhost:8000/api/v1

# Free MapLibre GL basemap style (OpenStreetMap data, no token required).
# Defaults to CARTO dark-matter; swap for an OSM raster style or a
# self-hosted style JSON. If the style cannot be fetched the map section
# falls back to an animated vector transmission-line illustration.
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Optional Supabase credentials. The platform reads/writes through the
# FastAPI provenance registry; Supabase is available for future auth/RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=