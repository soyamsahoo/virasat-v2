# VIRASAT frontend — environment template (copy to frontend/.env.local).
# Vite env vars are inlined at build time; restart the dev server after edits.

# Backend base URL. Defaults to same-origin /api/v1 (dev server proxy).
# Point at the deployed backend for staging/production:
# VITE_API_URL=https://virasat-api.example.com/api/v1

# MapLibre basemap style (defaults to CARTO dark matter; token-free).
# VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Optional Supabase direct client (future auth/storage integration) —
# leave unset unless RLS policies in backend/app/models/ddl.sql are applied.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=