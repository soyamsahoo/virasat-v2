# VIRASAT backend — environment template (copy to backend/.env).
# Every value may also be set as a platform environment variable.

# --- Persistence -----------------------------------------------------------
# Leave unset for demo mode (in-memory, seeded from backend/seed_data/).
# For Supabase / PostgreSQL provide the connection DSN:
#   VIRASAT_DATABASE_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# NOTE: connect with the *service role* key so RLS policies in
# app/models/ddl.sql apply only to direct anon/authenticated clients.

# --- Security --------------------------------------------------------------
# When set, POST endpoints require `X-API-Key` matching this value.
# VIRASAT_API_KEY=

# --- Computer vision -------------------------------------------------------
# VIRASAT_BLUR_THRESHOLD=100.0
# VIRASAT_HASH_HAMMING_THRESHOLD=10
# VIRASAT_ORB_KEYPOINTS=1000

# --- URL topology ----------------------------------------------------------
# Public base URL of this backend (used for image URLs, QR + PDF links).
VIRASAT_PASSPORT_BASE_URL=http://localhost:8000
# Frontend URL used to build the verify QR link.
VIRASAT_VERIFY_FRONTEND_URL=http://localhost:4173/verify

# --- CORS ------------------------------------------------------------------
# Origins allowed to call this API (JSON array). Set on Vercel to your
# frontend deployment, e.g.:
# VIRASAT_CORS_ORIGINS=["https://virasat-v2.vercel.app"]
# VIRASAT_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- Vercel notes ----------------------------------------------------------
# Root Directory: backend  |  Install: pip install -r requirements.txt
# Runtime deps (opencv-python-headless, scipy, reportlab) are large (~80MB);
# confirm the first deploy within Vercel's 250MB uncompressed function limit,
# or move the CV pipeline to a worker service (Railway/Fly) if exceeded.
# MAX_UNCOMPRESSED_LAMBDA_SIZE=262144000 (account setting)