# --- Persistence ----------------------------------------------------------
# Set to a PostgreSQL/Supabase connection string to leave demo mode.
# When unset, the API runs in memory mode pre-loaded from seed_data/
# (backend/seed_data on Vercel).
# VIRASAT_DATABASE_URL=postgresql://postgres:PASSWORD@db.supabase.co:5432/postgres

# --- Security -------------------------------------------------------------
# When set, all mutations require an X-API-Key header with this value.
# VIRASAT_API_KEY=

# --- CORS -----------------------------------------------------------------
# Origins allowed to call this API (JSON array). Set on Vercel to your
# frontend deployment, e.g.:
# VIRASAT_CORS_ORIGINS=["https://virasat-v2.vercel.app"]
# VIRASAT_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# --- URL topology ---------------------------------------------------------
# Public base URLs used in issued passports (QR + PDF links).
# VIRASAT_PASSPORT_BASE_URL=https://<backend-deployment>.vercel.app
# VIRASAT_VERIFY_FRONTEND_URL=https://<frontend-deployment>.vercel.app/verify